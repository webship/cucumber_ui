{
  "name": "cucumber_ui",
  "description": "Create and run Cucumber/Gherkin tests from the web interface using webship-js.",
  "private": true,
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "keywords": [
    "Drupal",
    "Testing",
    "Cucumber",
    "Cucumber UI",
    "Automated Testing",
    "Automates Functional Testing"
  ],
  "author": "Webship.co",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "theme:build": "node scripts/css/postcss-build.js",
    "theme:watch": "node scripts/css/postcss-watch.js",
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:headed": "HEADLESS=false node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-jquery": "^1.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-yml": "^1.0.0",
    "glob": "^8.0.0",
    "minimist": "^1.0.0",
    "mkdirp": "^1.0.0",
    "postcss": "^8.0.0",
    "postcss-header": "^3.0.0",
    "postcss-import": "^15.0.0",
    "postcss-preset-env": "^8.0.0",
    "postcss-pxtorem": "^6.0.0",
    "postcss-url": "^10.0.0",
    "prettier": "^2.0.0",
    "stylelint": "^15.0.0",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^33.0.0",
    "stylelint-order": "^6.0.0",
    "terser": "^5.0.0",
    "terser-webpack-plugin": "^5.0.0",
    "underscore": "^1.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webship-js": "^2.0.0"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "Firefox ESR"
  ],
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@cucumber/cucumber": "10.0.1"
  }
}
